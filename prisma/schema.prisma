generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   BigInt?  @unique
  googleId     String?  @unique
  email        String?  @unique
  name         String?
  jobTitle     String?
  location     String?
  experience   String?  // "0-2" | "3-5" | "6-10" | "10+"
  username     String?
  pushToken    String?  // Expo push token for mobile notifications
  // Career profile
  currentLevel String?  // "junior" | "mid" | "senior" | "staff" | "principal" | "lead" | "director" | "vp"
  targetRoles  String?  // JSON array e.g. ["Staff PM", "Head of Product"]
  strengths    String?  // JSON array — AI-inferred from evidence over time
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  authTokens        AuthToken[]
  notifications     Notification[]
  industryFollows   IndustryFollow[]
  savedJobs         SavedJob[]
  savedLeads        SavedLead[]
  applications      Application[]
  followedCompanies FollowedCompany[]
  jobAlerts         JobAlert[]
  cv                UserCV?
  workItems         WorkItem[]
  portfolios        Portfolio[]
  chatSession       ChatSession?
  evidence          Evidence[]
  careerArtifacts   CareerArtifact[]
  jobMatches        JobMatch[]
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  context   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model SavedJob {
  id      Int      @id @default(autoincrement())
  userId  Int
  title   String
  company String
  location String
  url     String
  salary  String?
  jobType String?
  source  String?
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, url])
}

model SavedLead {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  role      String?
  company   String
  email     String?
  linkedIn  String?
  source    String?
  savedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, company, name])
}

model Application {
  id           Int       @id @default(autoincrement())
  userId       Int
  jobTitle     String
  company      String
  url          String?
  status       String    @default("saved")
  notes        String?
  appliedAt    DateTime?
  prepPackJson String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model UserCV {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  filename   String
  rawText    String   @db.Text
  fileHash   String?  // SHA-256 of the PDF buffer for duplicate detection
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model FollowedCompany {
  id                   Int       @id @default(autoincrement())
  userId               Int
  name                 String
  atsType              String?   // "greenhouse" | "lever" | "workable" | "ashby" | "careers_page" | "unknown"
  atsToken             String?   // board slug used by the ATS
  careersUrl           String?   // direct careers page URL for non-ATS companies
  desiredRoles         String    @default("designer") // comma-separated keywords
  industry             String?   // "Fintech" | "SaaS" | "HealthTech" | "EdTech" | "E-commerce" | "AI / ML" | "Crypto / Web3" | "Media" | "Gaming" | "Climate"
  continent            String?   // "North America" | "Europe" | "Asia" | "Latin America" | "Africa" | "Oceania" | "Global"
  remoteFriendly       Boolean   @default(false)
  // Company intelligence
  stack                String?   // JSON array of tech/tools they use
  hiringManagerName    String?
  hiringManagerRole    String?
  hiringManagerLinkedIn String?
  fitScore             Float?    // AI-computed 0-1 match against user's evidence
  lastChecked          DateTime?
  createdAt            DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id])
  alerts          JobAlert[]
  careerArtifacts CareerArtifact[]
  jobMatches      JobMatch[]

  @@unique([userId, name])
}

model JobAlert {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int
  jobTitle  String
  jobUrl    String
  sentAt    DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id])
  company FollowedCompany @relation(fields: [companyId], references: [id])

  @@unique([companyId, jobUrl])
}

model WorkItem {
  id           Int      @id @default(autoincrement())
  userId       Int
  title        String
  description  String   @db.Text
  role         String?  // user's role in the project
  tools        String?  // comma-separated tools
  outcome      String?  // key result / metric
  imageUrl     String?  // comma-separated image URLs (page screenshots)
  projectUrl   String?  // link to live project or case study
  tags         String?  // comma-separated e.g. "mobile, fintech, design systems"
  sectionsJson String?  @db.Text // JSON array of content sections for the project page
  fileHash     String?  // SHA-256 of the PDF buffer for duplicate detection
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  userId      Int
  slug        String   @unique
  jobTitle    String?
  company     String?
  htmlContent String   @db.Text
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuthToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // "new_role" | "interview_reminder" | "application_sent" | "application_processing"
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  messagesJson String   @db.Text
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IndustryFollow {
  id        Int      @id @default(autoincrement())
  userId    Int
  industry  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, industry])
}

model Evidence {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  summary     String    @db.Text
  roleType    String    // "eng" | "pm" | "data" | "design" | "ops" | "leadership"
  impact      String?   // key result / metric
  skills      String?   // JSON array e.g. ["React", "LLM fine-tuning"]
  aiInvolved  Boolean   @default(false)
  periodFrom  DateTime?
  periodTo    DateTime?
  artifactsJson String? @db.Text // JSON array of { url, type, label }
  rawNotes    String?   @db.Text // unstructured input before AI structures it
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerArtifacts CareerArtifact[]
}

model CareerArtifact {
  id              Int       @id @default(autoincrement())
  userId          Int
  type            String    // "cv" | "interview_pack" | "case_study" | "skill_proof" | "outreach_message"
  targetRole      String?
  targetCompanyId Int?
  content         String    @db.Text
  evidenceIds     String?   // JSON array of Evidence IDs used to generate this
  version         Int       @default(1)
  slug            String?   @unique // for public case study pages
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCompany FollowedCompany? @relation(fields: [targetCompanyId], references: [id])
  evidence      Evidence[]
}

// Remote job websites / sources we track for job listings
model JobSource {
  id            Int       @id @default(autoincrement())
  name          String    @unique  // e.g. "FlexJobs"
  url           String             // e.g. "flexjobs.com"
  description   String?            // what the site is known for
  category      String    @default("remote-board") // "remote-board" | "freelance" | "aggregator" | "community" | "niche"
  sourceCount   Int       @default(1) // how many independent lists it appeared in (proxy for popularity)
  active        Boolean   @default(true)  // whether we're actively tracking it
  adapter       String?            // fetcher key when the source has a pollable API, e.g. "remoteok" | "jobicy" | "remotive" | "workingnomads"
  lastCheckedAt DateTime?
  lastJobCount  Int       @default(0) // postings seen on the most recent poll
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  postings JobPosting[]
}

// A single job listing pulled from a JobSource's public API
model JobPosting {
  id         Int       @id @default(autoincrement())
  sourceId   Int
  externalId String?             // the source's own id, when available
  title      String
  company    String
  location   String?
  url        String
  jobType    String?
  salary     String?
  tags       String?             // JSON array of strings
  postedAt   DateTime?
  fetchedAt  DateTime  @default(now())

  source JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, url])
  @@index([sourceId, postedAt])
}

model JobMatch {
  id          Int      @id @default(autoincrement())
  userId      Int
  companyId   Int
  jobTitle    String
  jobUrl      String?  // null for generic (no specific opening)
  matchScore  Float    // 0-1
  matchReason String
  matchSkills String?  // JSON array of matching skills
  isGeneric   Boolean  @default(false) // true = company-level match, no specific opening
  generatedAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company FollowedCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
}
